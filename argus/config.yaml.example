# Argus configuration — copy to ~/.config/argus/config.yaml and fill in.
#
# Secrets are NOT stored here: ${VAR} is expanded from the environment at load
# time (systemd EnvironmentFile, or your shell). The real config is gitignored
# and mirrored to shq-suite-config.

ha:
  url: "http://localhost:8123"          # atlas-local Home Assistant
  token: "${HA_TOKEN}"                  # long-lived token (HA UI → profile → long-lived tokens)

anthropic:
  api_key: "${ANTHROPIC_API_KEY}"
  live_model: "claude-sonnet-4-6"       # Phase 1 uses this one (live what/where loop)
  id_model: "claude-opus-4-8"           # reserved for Phase 2 (forensic who + dossier)

# Path to the private premises seed (see seed.example.md). Phase 1 may point this
# at a copy of seed.example.md; the real seed lives in shq-suite-config / wiki.
seed_path: "~/.config/argus/seed.md"

# Cameras captured every assessment tick. The real config lists the full set
# (perimeter, front yard, outdoor living, garage, laundry, kitchen, hallway,
# stair landing, …). Each camera's still is sent to the live (Sonnet) loop.
cameras:
  - entity: "camera.garage_camera_high_resolution_channel"
    label: "Garage"                     # human label included in the prompt
  # - entity: "camera.front_yard_camera_high_resolution_channel"
  #   label: "Front Yard"

alarm_entity: "alarm_control_panel.shq_alarm"

# Assessment-loop cadence + cost guardrails (Phase 2).
loop_config:
  cadence_secs: 6                       # seconds between ticks while triggered
  daily_token_cap: null                 # optional billable-input-token/day cap; null = none
  slow_cadence_secs: 30                 # cadence used once the daily cap is hit

# Security-relevant HA entities pulled as per-tick telemetry (door/window/motion/
# reed/DOSA). Rendered as a text block after the cached seed. Optional.
telemetry_entities: []
  # - binary_sensor.garage_door
  # - binary_sensor.front_door

# Offsite case replication to S3 (Phase 2a). Mirrors the on-disk case dir
# (events, best stills, state, dossier) to an immutable S3 bucket in real time so
# the case survives destruction of atlas mid-incident. The case dir is the durable
# upload queue (per-file `.uploaded` markers + retry/backoff). Disabled by default;
# an absent block is equivalent to `enabled: false`.
#
# Provision: a DEDICATED bucket in ap-southeast-2, Block Public Access on,
# versioning + Object Lock (compliance mode, ~1y retention), SSE-S3. atlas gets a
# WRITE-ONLY IAM key (s3:PutObject only, scoped to cases/*) — no Delete/Get/List —
# so a compromised atlas cannot read or erase prior evidence. Retrieval uses a
# separate, locked-down principal. Keep bucket name/region in the private config.
#
# offsite:
#   enabled: false
#   bucket: "shq-argus-cases"             # estate detail — keep in private config
#   region: "ap-southeast-2"              # away-from-premises region
#   prefix: "cases"                       # key = <prefix>/<case_id>/<rest>
#   aws_access_key_id: "${AWS_ACCESS_KEY_ID}"          # write-only IAM key
#   aws_secret_access_key: "${AWS_SECRET_ACCESS_KEY}"  # never committed
#   upload:
#     best_stills: always                 # evidence is never throttled
#     routine_frames: sampled             # always | sampled | never (forward-compat; see CLAUDE.md)
#     routine_sample_secs: 30
#     retry_backoff_secs: [2, 5, 15, 60]  # per-pass backoff on PUT failures
#     scan_interval_secs: 5               # periodic re-scan fallback (also crash recovery)

# Overwatch gRPC voice output (Phase 3). Present = Argus speaks POSITIVE-ONLY
# milestones (intruder identified / clear image captured / security station
# notified) and drives the security klaxon (SetAlarm loop) to intimidate an
# intruder. The gate structurally never speaks a failure/uncertainty. Absent
# block = voice disabled. Connection/RPC failures are logged, never fatal.
#
# overwatch:
#   host: "<overwatch-host>"              # the voice RPi (gRPC plaintext on the LAN)
#   port: 50051
#   alarm_id: "security"                  # key in Overwatch's `alarms` config map
#   voice_id: "Amy"                       # AWS Polly voice for Verbalise
#   volume: 1.0                           # 0.0–1.0, for both klaxon and speech

# PagerDuty Events v2 security-station dispatch (Phase 3). trigger on case open +
# material change (same dedup_key = case_id), resolve on standdown. The dossier
# (threat level, intruders, recent timeline, and the bare S3 case prefix if
# offsite is configured) rides in custom_details. An ABSENT block OR an empty
# routing_key disables PagerDuty — that is NOT a startup blocker (a build/CI box
# has no key). The routing_key is never logged.
#
# pagerduty:
#   routing_key: "${PAGERDUTY_ROUTING_KEY}"   # Events v2 integration key; empty = disabled
#   source: "argus@atlas"                     # payload.source label

# Kiosk HUD HTTP/WS server + takeover (Phase 4) + the HA control WS (Phase 5).
# When `web:` is present Argus serves the sci-fi HUD web app at /alarm, the case
# stills at /stills/<id>.jpg, a /kiosk WebSocket that pushes the full CaseState
# (the same serde shape journalled to disk) on every change, AND a /control
# WebSocket (Phase 5) the HA `argus` component connects to for status +
# acknowledge/standdown commands. The control WS shares this same `bind` port —
# NO separate config/port. ABSENT block = neither the HUD server nor the control
# WS is spawned. `bind` is the LAN listen address (so kiosks can reach it);
# `public_base` is the LAN-reachable base URL kiosks are navigated to
# (`<public_base>/alarm`) — set it to atlas's real address, NOT 0.0.0.0. `dir`
# is the static HUD app dir; a relative path resolves next to the argus binary
# (a deployed `web/` beside the binary just works).
#
# web:
#   bind: "0.0.0.0:8770"
#   public_base: "http://atlas:8770"
#   dir: "web"

# Wall kiosks to take over on trigger (Phase 4). On the first CaseState of a case
# Argus calls `shq_display.navigate` for each kiosk → `<web.public_base>/alarm`;
# on `cleared` it navigates each back to its `dashboard_url`. `ha_target` is the
# shq_display device id (the `device_id` of the navigate service). EMPTY (or
# absent) = no takeover — the HUD is still served, just not pushed to any kiosk.
# Takeover only runs when `web:` is also configured.
#
# NOTE (nyx dependency): a bare `shq_display.navigate` does NOT wake a sleeping
# kiosk or kill a Chronos clock overlay (idle_mode: clock), so on those kiosks
# the takeover is invisible until nyx gains a navigate-implies-wake behaviour (or
# a `shq_display.wake` is called first). See argus/CLAUDE.md + 04-kiosk-hud.md.
#
# kiosks:
#   - { ha_target: "kiosk03", dashboard_url: "http://athena/lovelace/kitchen" }
#   - { ha_target: "kiosk04", dashboard_url: "http://athena/lovelace/bedroom" }
