# Argus secrets / environment — copy to ~/.config/argus/argus.env on the host
# (gitignored; NEVER commit the filled-in file). systemd reads it as the
# container's EnvironmentFile (see argus.container) and Argus expands the ${VAR}
# placeholders in config.yaml from these at load time.

# Home Assistant. On atlas (Network=host) HA is reachable on the loopback.
HA_URL=http://localhost:8123
HA_TOKEN=

# Anthropic API key (the live Sonnet loop + the Opus forensic pass).
ANTHROPIC_API_KEY=

# Optional — PagerDuty Events v2 routing key. Empty/absent = PagerDuty disabled.
# PAGERDUTY_ROUTING_KEY=

# Optional — offsite S3 (Phase 2a) write-only IAM creds. Only needed when the
# `offsite:` block in config.yaml is enabled.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
